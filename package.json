{
  "name": "skylily-smart-router",
  "version": "1.1.0",
  "description": "Intelligent LLM model router that analyzes task complexity and routes to the optimal model. Save 10-100x on costs while maintaining quality.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "smart-router": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test",
    "clean": "rm -rf dist coverage",
    "prepack": "npm run clean && npm run build"
  },
  "keywords": [
    "llm",
    "model-routing",
    "ai",
    "cost-optimization",
    "openai",
    "anthropic",
    "claude",
    "gpt",
    "gemini",
    "task-analysis",
    "complexity-analysis",
    "model-selection",
    "smart-routing",
    "token-optimization",
    "ai-cost-reduction"
  ],
  "author": "Skylily 🌸 <skylily@puneet8800.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pkmdev-sec/skylily-smart-router.git"
  },
  "bugs": {
    "url": "https://github.com/pkmdev-sec/skylily-smart-router/issues"
  },
  "homepage": "https://github.com/pkmdev-sec/skylily-smart-router#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
